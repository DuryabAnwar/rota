# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Gemini (free key from aistudio.google.com > Get API key)
GEMINI_API_KEY=
# If you get a 'model not found' error, set this to a Flash model listed in AI Studio
GEMINI_MODEL=gemini-2.5-flash
# Public URL of the app. PayPal redirects buyers back here after approval.
BASE_URL=http://localhost:8000
# Optional: enables the webhook backup path (see README)
PAYPAL_WEBHOOK_ID=
# Set to 1 only if Payouts is not available in your sandbox. The UI labels payouts as simulated.
SIMULATE_PAYOUT=0
